# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# The dev server writes here when it is started detached for a preview.
dev-server.log

# env files (can opt-in for committing if needed)
.env*
# ...but the placeholder example file should be committable.
!.env.local.example

# vercel
.vercel

# local agent config & reference material (not part of the site)
.claude/
*.pdf
.playwright-mcp/

# working notes and source material. Named one by one rather than by pattern
# so a doc that should ship (CLAUDE.md, a README) can't be swallowed.
# CONTEXT.md is a session checkpoint that gets rewritten, not a document.
/CONTEXT.md
/design-assets/

# outreach: the tooling is committed, the lead list is not. This repository is
# public, and the file holds business phone numbers alongside notes like "their
# site is broken" — written for me, not for them to read. If the repository
# ever goes private, delete these four lines and the list travels with it.
/outreach/data/*
!/outreach/data/leads.example.json
!/outreach/data/seed-barcelona.json
/outreach/BOARD.md

# typescript
*.tsbuildinfo
next-env.d.ts

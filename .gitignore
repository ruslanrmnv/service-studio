# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the placeholder example file should be committable.
!.env.local.example

# vercel
.vercel

# local agent config & reference material (not part of the site)
.claude/
*.pdf
.playwright-mcp/

# working notes and source material: briefs, copy drafts, uncropped photos,
# retired components kept for reference. Named one by one rather than by
# pattern so a doc that should ship (CLAUDE.md, a README) can't be swallowed.
/CONTEXT.md
/design-spec.md
/humanizer-fixes.md
/offer-update.md
/repositioning-draft.md
/portfolio-dev-screenshot.png
/design-assets/

# typescript
*.tsbuildinfo
next-env.d.ts
